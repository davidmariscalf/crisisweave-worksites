{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidmariscalf/crisisweave-worksites/schema/worksite.schema.json",
  "title": "CrisisWeave Worksite",
  "type": "object",
  "required": ["id", "title", "work_type", "state", "priority", "people_needed", "skills", "hazards", "area", "geometry", "source"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "work_type": {"type": "string", "enum": ["debris_removal", "muck_out", "tree_removal", "tarping", "gutting", "delivery", "assessment", "other"]},
    "state": {"type": "string", "enum": ["requested", "triaged", "ready", "assigned", "in_progress", "completed", "cancelled"]},
    "priority": {"type": "string", "enum": ["urgent", "high", "normal", "low"]},
    "people_needed": {"type": "integer", "minimum": 1, "maximum": 1000},
    "skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "hazards": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "safety_notes": {"type": "string"},
    "coordinator_instructions": {"type": "string"},
    "area": {"type": "string", "minLength": 1},
    "location_precision": {"type": "string", "enum": ["exact", "approximate", "area_only"]},
    "visibility": {"type": "string", "enum": ["operational", "public"]},
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Point"},
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": -180, "maximum": 180},
            {"type": "number", "minimum": -90, "maximum": 90}
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["type", "name", "source_id"],
      "properties": {
        "type": {"type": "string", "enum": ["request", "assessment", "partner_import", "synthetic"]},
        "name": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "url": {"type": "string"}
      },
      "additionalProperties": true
    },
    "assigned_team": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": true
}
